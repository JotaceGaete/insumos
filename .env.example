# Proyecto Supabase exclusivo para la tienda de insumos. No reutilizar credenciales de Artesellos.
NEXT_PUBLIC_INSUMOS_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_INSUMOS_SUPABASE_ANON_KEY=your-anon-key
INSUMOS_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comercio y servicios de la nueva tienda.
NEXT_PUBLIC_INSUMOS_SITE_URL=http://localhost:3000
INSUMOS_WHATSAPP_E164=56900000000

# Pagos (mock|mercadopago, default mock — ver src/features/payments). El
# Access Token es server-side only y NO debe llegar nunca al bundle del
# browser. La Public Key queda reservada para una futura integración
# client-side (Checkout Bricks/wallet button) — no la usa este flujo.
INSUMOS_PAYMENT_PROVIDER=mock
INSUMOS_MP_ACCESS_TOKEN=
INSUMOS_MP_PUBLIC_KEY=
INSUMOS_MP_WEBHOOK_SECRET=

{
  "name": "artesellos-ecommerce",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:insumos": "node ./node_modules/eslint/bin/eslint.js src/features src/app/api/insumos tests",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "test": "node --test tests/**/*.test.mjs",
    "pages:build": "npx @cloudflare/next-on-pages",
    "deploy": "npm run pages:build && wrangler pages deploy",
    "seed:knowledge": "node ./scripts/seedKnowledge.mjs"
  },
  "dependencies": {
    "@ai-sdk/openai": "latest",
    "@ai-sdk/react": "latest",
    "@heroicons/react": "^2.2.0",
